<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rewrites the assembly of every type reference in IL text to the .NET Framework assembly
    that defines the type. See Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>

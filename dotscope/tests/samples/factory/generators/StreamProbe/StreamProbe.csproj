<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The input of the stream-directory experiments (see MetadataVariants): a program that
    prints one value from each metadata heap.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>StreamProbe</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
